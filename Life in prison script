-- // Resolvers
local function resolveCriminalBase()
    local spawns = workspace:FindFirstChild("Spawns")
    if not spawns then return nil end
    local criminalSpawns = spawns:FindFirstChild("CriminalSpawns")
    if not criminalSpawns then return nil end
    local spawnLocation = criminalSpawns:FindFirstChild("SpawnLocation")
    if not spawnLocation then return nil end
    if spawnLocation:IsA("BasePart") then return spawnLocation.CFrame * CFrame.new(0, 5, 0) end
    for _, v in ipairs(spawnLocation:GetDescendants()) do
        if v:IsA("BasePart") then return v.CFrame * CFrame.new(0, 5, 0) end
    end
    return nil
end

local function resolveGuardsBase()
    local spawns = workspace:FindFirstChild("Spawns")
    if not spawns then return nil end
    local policeSpawns = spawns:FindFirstChild("PoliceSpawns")
    if not policeSpawns then return nil end
    local target = policeSpawns:GetChildren()[7]
    if not target then return nil end
    if target:IsA("BasePart") then return target.CFrame * CFrame.new(0, 5, 0) end
    for _, v in ipairs(target:GetDescendants()) do
        if v:IsA("BasePart") then return v.CFrame * CFrame.new(0, 5, 0) end
    end
    return nil
end

local function teleport(resolver)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local cf = resolver()
    if not cf then return end
    root.CFrame = cf
end

-- // Godmode
local godmodeActive = false
local healthConn = nil
local loopThread = nil

local function stopGodmode(godBtn, statusLbl)
    godmodeActive = false
    if healthConn then healthConn:Disconnect() healthConn = nil end
    if loopThread then task.cancel(loopThread) loopThread = nil end
    godBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 0)
    godBtn.Text = "Godmode"
    if statusLbl then statusLbl.Text = "" end
end

local function attachGodmode(godBtn, statusLbl)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    local savedCFrame = root.CFrame
    loopThread = task.spawn(function()
        while godmodeActive do
            local c = player.Character
            if c then
                local r = c:FindFirstChild("HumanoidRootPart")
                local h = c:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then savedCFrame = r.CFrame end
            end
            task.wait(0.05)
        end
    end)
    healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if hum.Health <= 0 and godmodeActive then
            statusLbl.Text = "💀 died — respawning..."
            local deathCFrame = savedCFrame
            local newChar = player.CharacterAdded:Wait()
            task.wait(0.3)
            local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
            if newRoot then
                newRoot.CFrame = deathCFrame
                statusLbl.Text = "✓ snapped back"
            end
            if godmodeActive then
                if healthConn then healthConn:Disconnect() end
                if loopThread then task.cancel(loopThread) end
                attachGodmode(godBtn, statusLbl)
            end
        end
    end)
end

-- // Spectate
local spectateActive = false
local spectateConn = nil
local selectedPlayer = nil
local selectedBtn = nil

local function stopSpectate(specBtn, specStatus)
    spectateActive = false
    if spectateConn then spectateConn:Disconnect() spectateConn = nil end
    camera.CameraType = Enum.CameraType.Custom
    local selfChar = player.Character
    camera.CameraSubject = selfChar and selfChar:FindFirstChildOfClass("Humanoid") or nil
    specBtn.Text = "Spectate Player"
    specBtn.BackgroundColor3 = Color3.fromRGB(30, 60, 120)
    if specStatus then specStatus.Text = "" end
end

local function startSpectate(target, specBtn, specStatus)
    if not target then
        if specStatus then specStatus.Text = "⚠ pick a player first" end
        return
    end
    local targetChar = target.Character
    if not targetChar then
        if specStatus then specStatus.Text = "⚠ player has no character" end
        return
    end
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetHum then
        if specStatus then specStatus.Text = "⚠ target not loaded" end
        return
    end
    spectateActive = true
    specBtn.Text = "Stop Spectate"
    specBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
    if specStatus then specStatus.Text = "👁 spectating " .. target.Name end
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = targetHum
    spectateConn = target.CharacterAdded:Connect(function(newChar)
        task.wait(0.3)
        local newHum = newChar:WaitForChild("Humanoid", 5)
        if newHum and spectateActive then
            camera.CameraSubject = newHum
        end
    end)
end

-- // Goto Player
local function gotoPlayer(target, statusLbl)
    if not target then
        if statusLbl then statusLbl.Text = "⚠ pick a player first" end
        return
    end
    local targetChar = target.Character
    if not targetChar then
        if statusLbl then statusLbl.Text = "⚠ player has no character" end
        return
    end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        if statusLbl then statusLbl.Text = "⚠ cant find player" end
        return
    end
    local myChar = player.Character
    if not myChar then
        if statusLbl then statusLbl.Text = "⚠ no character" end
        return
    end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        if statusLbl then statusLbl.Text = "⚠ no root" end
        return
    end
    -- teleport slightly beside the target so we dont clip into them
    myRoot.CFrame = targetRoot.CFrame * CFrame.new(3, 0, 0)
    if statusLbl then
        statusLbl.Text = "✓ went to " .. target.Name
        task.delay(3, function()
            if statusLbl and statusLbl.Parent then statusLbl.Text = "" end
        end)
    end
end

