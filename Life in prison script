-- // Player buttons
local function makePlayerBtn(p)
    if p == player then return end
    local pb = Instance.new("TextButton")
    pb.Size = UDim2.new(1, -6, 0, 30)
    pb.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    pb.BorderSizePixel = 0
    pb.Text = p.Name
    pb.TextColor3 = Color3.fromRGB(210, 210, 255)
    pb.TextSize = 11
    pb.Font = Enum.Font.GothamBold
    pb.Name = p.Name
    pb.Parent = scroll
    Instance.new("UICorner", pb).CornerRadius = UDim.new(0, 6)

    pb.MouseButton1Click:Connect(function()
        if selectedBtn then
            selectedBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            selectedBtn.TextColor3 = Color3.fromRGB(210, 210, 255)
        end
        selectedPlayer = p
        selectedBtn = pb
        pb.BackgroundColor3 = Color3.fromRGB(99, 60, 255)
        pb.TextColor3 = Color3.fromRGB(255, 255, 255)
        specStatus.Text = p.Name .. " selected"
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    makePlayerBtn(p)
end

Players.PlayerAdded:Connect(function(p)
    makePlayerBtn(p)
end)

Players.PlayerRemoving:Connect(function(p)
    local btn = scroll:FindFirstChild(p.Name)
    if btn then btn:Destroy() end
    if selectedPlayer == p then
        selectedPlayer = nil
        selectedBtn = nil
        specStatus.Text = "player left"
        if spectateActive then stopSpectate(specBtn, specStatus) end
    end
end)

player.CharacterAdded:Connect(function()
    if godmodeActive then
        task.wait(0.3)
        attachGodmode(godBtn, godStatus)
    end
end)
